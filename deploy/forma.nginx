limit_req_zone $binary_remote_addr zone=forma_per_ip:1m rate=3r/s;
limit_conn_zone $binary_remote_addr zone=forma_connections:1m;
server {
    listen 80;
    server_name 89.125.202.66 r840525.s1698.vm.mydomain.zone;
    client_max_body_size 20k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    access_log off;
    location / {
        limit_conn forma_connections 12;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }
    location /api/ {
        limit_req zone=forma_per_ip burst=6 nodelay;
        limit_req_status 429;
        limit_conn forma_connections 4;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        # Cold personal days may need the full 30-second worker deadline.
        proxy_read_timeout 65s;
    }
}
