[Unit]
Description=Forma private-source web application
After=network.target

[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma/current
Environment=HOST=127.0.0.1
Environment=PORT=4173
# Packet filenames contain the calculation fingerprint; no manual v1/v2 path.
Environment=TRANSIT_CACHE_DIR=/var/cache/forma/transit
# Run npm run prepare:lifetime in the project before starting.
# .cache/lifetime may point to shared data preserved across releases.
# The HTTP service reads the completed file; it never starts preparation.
Environment=FORMA_LIFETIME_FILE=/opt/forma/current/.cache/lifetime/lifetime-1801-2400.f64le
CacheDirectory=forma
CacheDirectoryMode=0700
ExecStart=/opt/forma/node/bin/node server/server.mjs --release
Restart=on-failure
RestartSec=5
MemoryMax=400M
CPUQuota=50%
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
