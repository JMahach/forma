{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Local-first interactive Human Design bodygraph studio",
  "scripts": {
    "start": "node server/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:python": "node scripts/python.ts -m unittest discover -s tests -p \"test_*.py\"",
    "build": "node scripts/build-web.ts",
    "prepare:lifetime": "node scripts/python.ts -m server.python.lifetime_file --file .cache/lifetime/lifetime-1801-2400.f64le",
    "start:release": "node server/server.ts --release",
    "prepare:returns": "node scripts/python.ts -m server.python.return_index --file .cache/returns/return-index.bin",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "check:architecture": "node scripts/architecture/run.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jose": "6.2.13",
    "nodemailer": "10.2.1"
  }
}
