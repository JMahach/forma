[Unit]
Description=Forma private-source web application
After=network.target

[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma/current
Environment=HOST=127.0.0.1
Environment=PORT=4173
# Packet filenames contain the calculation fingerprint; no manual v1/v2 path.
Environment=TRANSIT_CACHE_DIR=/var/cache/forma/transit
# Prepare .cache/lifetime as user forma with npm run prepare:lifetime in the project.
# Once ready, the next browser request opens it; no service restart is needed.
CacheDirectory=forma
CacheDirectoryMode=0700
ExecStart=/opt/forma/node/bin/node server/server.mjs --release
Restart=on-failure
RestartSec=5
MemoryMax=400M
CPUQuota=50%
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
