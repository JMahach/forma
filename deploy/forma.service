[Unit]
Description=Forma private-source web application
After=network.target

[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma/current
Environment=HOST=127.0.0.1
Environment=PORT=4173
# Packet filenames contain the calculation fingerprint; no manual v1/v2 path.
Environment=TRANSIT_CACHE_DIR=/var/cache/forma/transit
# Provision the verified lifetime file and adjacent .metadata.json before starting.
# This service reads the lifetime file; it never generates or replaces its 6.05 GB.
Environment=FORMA_LIFETIME_FILE=/var/cache/forma/lifetime/lifetime-1801-2400.f64le
CacheDirectory=forma
CacheDirectoryMode=0700
ExecStart=/opt/forma/node/bin/node server/server.mjs --release
Restart=on-failure
RestartSec=5
MemoryMax=400M
CPUQuota=50%
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
