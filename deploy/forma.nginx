# Prepared timeline data never shares the calculator's request budget.
limit_req_zone $binary_remote_addr zone=forma_compute:1m rate=3r/s;
limit_conn_zone $binary_remote_addr zone=forma_compute_connections:1m;
limit_conn_zone $binary_remote_addr zone=forma_connections:1m;
server {
    listen 80;
    server_name 153.76.161.24;
    client_max_body_size 20k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    access_log off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    limit_req_status 429;
    location / {
        limit_conn forma_connections 12;
        proxy_pass http://127.0.0.1:4173;
    }
    location ~ ^/api/(?:lifetime(?:/meta)?|transit/day)$ {
        # A missing day still uses Node's bounded calculation queue.
        proxy_read_timeout 65s;
        proxy_pass http://127.0.0.1:4173;
    }
    location /api/ {
        limit_req zone=forma_compute burst=6 nodelay;
        limit_conn forma_compute_connections 4;
        # Cold personal days may need the full 30-second worker deadline.
        proxy_read_timeout 65s;
        proxy_pass http://127.0.0.1:4173;
    }
}
