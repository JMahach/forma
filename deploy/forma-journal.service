[Unit]
Description=Forma sole durable journal writer
After=local-fs.target

[Service]
Type=notify
NotifyAccess=all
User=forma
# The nginx worker may send to the status-only datagram socket. The archive and
# services.sock remain private to the forma UID, irrespective of this group.
Group=www-data
WorkingDirectory=/opt/forma/current
Environment=FORMA_STATE_DIR=/var/lib/forma
Environment=FORMA_JOURNAL_DIR=/var/log/forma
Environment=FORMA_ENVIRONMENT=production
Environment=FORMA_JOURNAL_WRITER=external
Environment=FORMA_JOURNAL_NGINX_SOCKET=/run/forma-journal/nginx.sock
EnvironmentFile=/etc/forma/environment
# prepare-storage and release preflight require this private forma-owned zone.
# Do not recursively change its group when this service starts as www-data.
ReadWritePaths=/var/log/forma
RuntimeDirectory=forma-journal
RuntimeDirectoryMode=0750
ExecStart=/opt/forma/node/bin/node server/journal-service.ts
KillMode=mixed
TimeoutStartSec=90s
TimeoutStopSec=15s
Restart=on-failure
RestartSec=5
# Local Node/Python RSS is measured; validate this cgroup limit on Linux before release.
MemoryMax=256M
OOMPolicy=stop
CPUQuota=50%
TasksMax=24
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
