# Install privately as /etc/forma/environment. Set the deployed revision before start.
# FORMA_APP_VERSION=<git commit of the deployed checkout>
FORMA_STATE_DIR=/var/lib/forma
FORMA_JOURNAL_DIR=/var/log/forma
FORMA_ENVIRONMENT=production
FORMA_JOURNAL_WRITER=external
FORMA_JOURNAL_NGINX_SOCKET=/run/forma-journal/nginx.sock
FORMA_ACCOUNT_ORIGINS=https://juxtaposition.ru
FORMA_TRUST_PROXY=loopback
# Optional, once the Telegram application is registered:
# FORMA_TELEGRAM_CLIENT_ID=<numeric client ID>
