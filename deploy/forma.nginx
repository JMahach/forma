# Include inside nginx's http context after installing the domain certificate.
limit_req_zone $binary_remote_addr zone=forma_compute:1m rate=3r/s;
limit_conn_zone $binary_remote_addr zone=forma_compute_connections:1m;
limit_conn_zone $binary_remote_addr zone=forma_connections:1m;
server {
    listen 80;
    server_name juxtaposition.ru;
    access_log off;
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }
    location / {
        return 308 https://juxtaposition.ru$request_uri;
    }
}
server {
    listen 443 ssl;
    server_name juxtaposition.ru;
    ssl_certificate /etc/letsencrypt/live/juxtaposition.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/juxtaposition.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    access_log off;
    limit_conn forma_connections 12;
    limit_req_status 429;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    # Codes, Telegram tokens and personal replies must not spill to proxy temp files.
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 3s;
    proxy_read_timeout 65s;
    location = /api/diagnostics {
        # Matches DIAGNOSTIC_BATCH_MAX_BYTES; this is not a calculation request.
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:4173;
    }
    location ~ ^/api/(?:calculate|cycles/(?:events|chart)|chart/day)$ {
        # One panel: 13 event lists + selected chart + birth day + form calculation.
        # Admit waiting requests; Node still bounds actual compute work to 4 workers.
        limit_req zone=forma_compute burst=15 nodelay;
        limit_conn forma_compute_connections 16;
        proxy_pass http://127.0.0.1:4173;
    }
    # Prepared data, account actions, cards and write-outcome reads share no
    # calculator rate budget. Expensive work still uses Node's bounded queue.
    location / {
        proxy_pass http://127.0.0.1:4173;
    }
}
