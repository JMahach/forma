{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Local-first interactive Human Design bodygraph studio",
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "build": "node scripts/build-web.mjs",
    "prepare:lifetime": ".venv/bin/python -m server.python.lifetime_file --file .cache/lifetime/lifetime-1801-2400.f64le",
    "start:release": "node server/server.mjs --release",
    "prepare:returns": ".venv/bin/python -m server.python.return_index --file .cache/returns/return-index.bin"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5"
  }
}
